{
  "name": "agentic-web-conformance",
  "version": "0.1.0",
  "description": "Check an Open Agentic Web site against the Worldwide Agentic Web MVP specification: `conform check <url>`.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "conform": "./dist-bundle/conform.mjs"
  },
  "exports": {
    ".": {
      "conform-source": "./src/index.ts",
      "default": "./dist-bundle/index.mjs"
    }
  },
  "files": [
    "dist-bundle",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agentic-web",
    "conformance",
    "neuro-san",
    "nsdeploy",
    "mcp",
    "cors",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=conform-source --test \"test/**/*.test.ts\"",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@conform/core": "workspace:*",
    "esbuild": "^0.28.1"
  }
}
